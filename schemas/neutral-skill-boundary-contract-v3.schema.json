{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osuite.ai/schemas/neutral-skill-boundary-contract-v3.schema.json",
  "title": "Vendor-Neutral Skill Boundary Contract v3",
  "description": "A minimal research contract for declaring requested skill authority independently from runtime authorization policy.",
  "type": "object",
  "required": [
    "schema_version",
    "boundary_id",
    "skill",
    "requested_principals",
    "requested_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-boundary-contract.v3"
    },
    "boundary_id": {
      "type": "string",
      "pattern": "^boundary\\.[a-z0-9][a-z0-9.-]+\\.v[0-9]+$"
    },
    "skill": {
      "type": "object",
      "required": ["name", "version", "purpose"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "purpose": { "type": "string" }
      },
      "additionalProperties": false
    },
    "requested_principals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "requested_authority": {
      "type": "object",
      "required": ["operations"],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "operation",
              "effect",
              "resource",
              "destination",
              "data_class",
              "required_evidence"
            ],
            "properties": {
              "operation": { "type": "string" },
              "effect": { "type": "string" },
              "resource": {
                "type": "object",
                "required": ["type", "pattern", "prefix"],
                "properties": {
                  "type": { "type": "string" },
                  "pattern": { "type": "string" },
                  "prefix": { "type": "string" }
                },
                "additionalProperties": false
              },
              "destination": { "type": "string" },
              "data_class": { "type": "string" },
              "constraints": {
                "type": "object",
                "properties": {
                  "amount_usd_lte": { "type": "number", "minimum": 0 },
                  "max_records": { "type": "number", "minimum": 0 },
                  "external_egress": { "type": "boolean" }
                },
                "additionalProperties": false
              },
              "required_evidence": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "not": {
    "anyOf": [
      { "required": ["runtime_lanes"] },
      { "required": ["risk_level"] },
      { "required": ["approval_required"] },
      { "required": ["escalation"] }
    ]
  },
  "additionalProperties": false
}
