{
  "name": "agent-action-boundary-benchmark",
  "version": "0.1.0",
  "description": "Open benchmark and reference demos for detecting approval-execution drift in AI agent actions.",
  "type": "module",
  "private": true,
  "scripts": {
    "benchmark": "node scripts/run-benchmark.mjs",
    "benchmark:runtime": "node scripts/run-benchmark.mjs --input benchmarks/runtime-boundary-corpus.jsonl --strict",
    "generate:runtime": "node scripts/generate-runtime-boundary-corpus.mjs --count 6000",
    "report": "node scripts/run-benchmark.mjs --write-report",
    "report:runtime": "node scripts/run-benchmark.mjs --input benchmarks/runtime-boundary-corpus.jsonl --write-report --strict --prefix runtime-boundary-benchmark",
    "second-run:baby-blue": "node scripts/prepare-baby-blue-second-run.mjs",
    "second-run:baby-blue:live": "node scripts/prepare-baby-blue-second-run.mjs --live",
    "test": "node --test tests/*.test.mjs && node scripts/run-benchmark.mjs --strict"
  },
  "keywords": [
    "agentic-ai",
    "ai-security",
    "agent-governance",
    "approval-execution-drift",
    "runtime-security",
    "owasp",
    "blackhat-arsenal"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/OndCo/Agent-Action-Boundary-Benchmark.git"
  },
  "bugs": {
    "url": "https://github.com/OndCo/Agent-Action-Boundary-Benchmark/issues"
  },
  "homepage": "https://github.com/OndCo/Agent-Action-Boundary-Benchmark#readme"
}
